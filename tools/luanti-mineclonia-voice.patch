+class VoiceFormSource final : public IFormSource
+{
+public:
+	explicit VoiceFormSource(const MinecloniaVoiceClient &voice) : m_voice(voice) {}
+
+	const std::string &getForm() const override
+	{
+		using namespace mineclonia_voice;
+		std::ostringstream os;
+		os << "formspec_version[8]size[9.4,7.5]no_prepend[]bgcolor[;true;#101410C4]"
+			"box[0,0;9.4,7.5;#202620]box[0,0;9.4,1.05;#151B16]"
+			"box[0,1.05;9.4,0.03;#65735E]"
+			"style_type[label;textcolor=#F2F5EF]"
+			"style_type[button,button_exit;border=false;bgimg=mcl_options_button.png;"
+			"bgimg_middle=3;textcolor=#FFFFFF]"
+			"style_type[button:hovered,button:focused,button_exit:hovered,button_exit:focused;"
+			"bgimg=mcl_options_button_highlighted.png]"
+			"style_type[label;font_size=*1.25]label[0.45,0.52;" << esc(gettext("Voice Chat"))
+			<< "]style_type[label;font_size=*1]label[0.45,1.45;"
+			<< esc(gettext("Joining a channel turns on your microphone.")) << ']';
+
+		auto button = [&](double x, double y, double width, const std::string &action,
+				const std::string &label) {
+			os << "button[" << x << ',' << y << ';' << width << ",0.64;"
+				<< action << ';' << esc(label) << ']';
+		};
+		os << "label[0.45,2.08;" << esc(gettext("Channels")) << ']';
+		os << "label[4.94,2.08;" << esc(gettext("In your channel")) << ']';
+		for (u8 room = 1; room <= ROOM_COUNT; ++room) {
+			const double y = 2.42 + (room - 1) * 0.81;
+			const std::string label = std::string(voiceRoomName(room)) + "   " +
+					std::to_string(m_voice.counts[room - 1]) + "/" + std::to_string(ROOM_CAPACITY);
+			if (room == m_voice.room || !m_voice.ready || m_voice.busy() ||
+					m_voice.counts[room - 1] == ROOM_CAPACITY) {
+				os << "box[0.45," << y << ";4.02,0.64;"
+					<< (room == m_voice.room ? "#476348" : "#333C33") << ']'
+					<< "label[0.68," << y + 0.32 << ';' << esc(label) << ']';
+			} else {
+				button(0.45, y, 4.02, "voice_join_" + std::to_string(room), label);
+			}
+		}
+		if (m_voice.room) {
+			os << "textlist[4.94,2.42;4.02,2.26;voice_members;";
+			const char *separator = "";
+			for (const auto &member : m_voice.members) {
+				os << separator << esc(member.second);
+				separator = ",";
+			}
+			os << ";0;false]";
+		} else {
+			os << "label[4.94,2.73;" << esc(gettext("You haven't joined a channel.")) << ']';
+		}
+
+		const char *status = nullptr;
+		using Status = MinecloniaVoiceClient::Status;
+		switch (m_voice.status) {
+		case Status::Loading: status = gettext("Loading voice channels…"); break;
+		case Status::Pending: status = gettext("Waiting for the server…"); break;
+		case Status::Full: status = gettext("That channel is full."); break;
+		case Status::TimedOut: status = gettext("The server didn't answer. Try again."); break;
+		default: break;
+		}
+		if (!status && m_voice.room) {
+			if (m_voice.microphone_error)
+				status = gettext("Microphone unavailable. Check your device and permissions.");
+			else if (!m_voice.deafened && !m_voice.playback_ready)
+				status = gettext("Voice output unavailable.");
+			else
+				status = m_voice.transmitting ? gettext("Microphone on") : gettext("Microphone muted");
+		}
+		if (status)
+			os << "label[0.45,5.08;" << esc(status) << ']';
+		if (m_voice.room && !m_voice.busy()) {
+			button(0.45, 5.55, 2.72, "voice_mic",
+					m_voice.transmitting ? gettext("Mute Mic") : gettext("Unmute Mic"));
+			button(3.34, 5.55, 2.72, "voice_deafen",
+					m_voice.deafened ? gettext("Unmute Voices") : gettext("Mute Voices"));
+			button(6.23, 5.55, 2.72, "voice_leave", gettext("Leave Channel"));
+		} else if (!m_voice.ready && !m_voice.busy()) {
+			button(0.45, 5.55, 4.02, "voice_retry", gettext("Retry"));
+		}
+		os << "button_exit[0.45,6.45;8.5,0.64;voice_done;" << esc(gettext("Back to Game")) << ']';
+		m_form = os.str();
+		return m_form;
+	}
+
+private:
+	static std::string esc(std::string text)
+	{
+		str_formspec_escape(text);
+		return text;
+	}
+
+	const MinecloniaVoiceClient &m_voice;
+	mutable std::string m_form;
+};
