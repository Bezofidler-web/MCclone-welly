@@ -0,0 +1,321 @@
+// Luanti
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include "mineclonia_voice_audio.h"
+#include "config.h"
+
+#if USE_SOUND
+#if defined(_WIN32)
+#include <al.h>
+#include <alc.h>
+#elif defined(__APPLE__)
+#define OPENAL_DEPRECATED
+#include <OpenAL/al.h>
+#include <OpenAL/alc.h>
+#else
+#include <AL/al.h>
+#include <AL/alc.h>
+#endif
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <unordered_map>
+#include <utility>
+
+namespace
+{
+constexpr ALCsizei SAMPLE_RATE = 16000;
+constexpr ALCsizei SAMPLES_PER_FRAME = SAMPLE_RATE / 50;
+constexpr ALCsizei CAPTURE_BUFFER_SAMPLES = SAMPLES_PER_FRAME * 10;
+constexpr ALCsizei MAX_CAPTURE_SAMPLES_PER_STEP = SAMPLES_PER_FRAME * 4;
+constexpr std::size_t PLAYBACK_BUFFERS = 6;
+constexpr std::size_t MAX_PLAYBACK_PEERS = 16;
+constexpr int MULAW_BIAS = 0x84;
+static_assert(SAMPLES_PER_FRAME == MinecloniaVoiceAudio::FRAME_BYTES);
+
+using SetThreadContext = ALCboolean (ALC_APIENTRY *)(ALCcontext *);
+using GetThreadContext = ALCcontext *(ALC_APIENTRY *)();
+
+unsigned char encodeSample(ALshort sample)
+{
+	int magnitude = std::min(std::abs(static_cast<int>(sample)), 32635) + MULAW_BIAS;
+	int exponent = 7;
+	for (int mask = 0x4000; exponent > 0 && !(magnitude & mask); mask >>= 1)
+		--exponent;
+	int mantissa = (magnitude >> (exponent + 3)) & 0xf;
+	int sign = sample < 0 ? 0x80 : 0;
+	return static_cast<unsigned char>(~(sign | (exponent << 4) | mantissa));
+}
+
+ALshort decodeSample(unsigned char value)
+{
+	int code = ~value & 0xff;
+	int magnitude = (((code & 0xf) << 3) + MULAW_BIAS) << ((code >> 4) & 7);
+	return (code & 0x80) ? MULAW_BIAS - magnitude : magnitude - MULAW_BIAS;
+}
+
+// The game uses a process-wide OpenAL context on its sound thread. A scoped
+// thread-local binding keeps voice calls out of that context and vice versa.
+class ContextBinding
+{
+public:
+	ContextBinding(ALCcontext *context, SetThreadContext set_context,
+			GetThreadContext get_context) :
+			m_set(set_context), m_previous(get_context()), m_bound(set_context(context))
+	{}
+
+	~ContextBinding()
+	{
+		if (m_bound)
+			m_set(m_previous);
+	}
+
+	explicit operator bool() const { return m_bound; }
+
+private:
+	SetThreadContext m_set;
+	ALCcontext *m_previous;
+	bool m_bound;
+};
+
+struct PlaybackStream
+{
+	ALuint source = 0;
+	std::array<ALuint, PLAYBACK_BUFFERS> buffers{};
+	std::array<ALuint, PLAYBACK_BUFFERS> available{};
+	std::size_t available_count = 0;
+	float idle = 0;
+
+	bool open()
+	{
+		alGetError();
+		alGenSources(1, &source);
+		if (alGetError() != AL_NO_ERROR)
+			return false;
+		alGenBuffers(buffers.size(), buffers.data());
+		if (alGetError() != AL_NO_ERROR) {
+			alDeleteSources(1, &source);
+			return false;
+		}
+		alSourcei(source, AL_SOURCE_RELATIVE, AL_TRUE);
+		alSourcef(source, AL_ROLLOFF_FACTOR, 0);
+		available = buffers;
+		available_count = available.size();
+		return true;
+	}
+
+	void close()
+	{
+		alDeleteSources(1, &source);
+		alDeleteBuffers(buffers.size(), buffers.data());
+	}
+
+	void update()
+	{
+		ALint processed = 0;
+		alGetSourcei(source, AL_BUFFERS_PROCESSED, &processed);
+		if (processed > 0 && std::size_t(processed) <= available.size() - available_count) {
+			alGetError();
+			alSourceUnqueueBuffers(source, processed, available.data() + available_count);
+			if (alGetError() == AL_NO_ERROR)
+				available_count += processed;
+		}
+	}
+
+	void start()
+	{
+		ALint state = 0;
+		alGetSourcei(source, AL_SOURCE_STATE, &state);
+		if (state != AL_PLAYING && available_count < available.size())
+			alSourcePlay(source);
+	}
+
+	void queue(std::string_view frame)
+	{
+		update();
+		if (!available_count)
+			return;
+
+		std::array<ALshort, SAMPLES_PER_FRAME> samples;
+		std::transform(frame.begin(), frame.end(), samples.begin(), decodeSample);
+		ALuint buffer = available[available_count - 1];
+		alGetError();
+		alBufferData(buffer, AL_FORMAT_MONO16, samples.data(),
+				samples.size() * sizeof(ALshort), SAMPLE_RATE);
+		if (alGetError() == AL_NO_ERROR) {
+			alSourceQueueBuffers(source, 1, &buffer);
+			if (alGetError() == AL_NO_ERROR)
+				--available_count;
+		}
+		if (available.size() - available_count >= 3)
+			start();
+	}
+};
+} // namespace
+
+struct MinecloniaVoiceAudio::Impl
+{
+	ALCdevice *microphone = nullptr;
+	ALCdevice *output = nullptr;
+	ALCcontext *context = nullptr;
+	SetThreadContext set_context = nullptr;
+	GetThreadContext get_context = nullptr;
+	std::unordered_map<std::uint16_t, PlaybackStream> streams;
+};
+
+bool MinecloniaVoiceAudio::enablePlayback()
+{
+	if (m_impl->context)
+		return true;
+
+	m_impl->output = alcOpenDevice(nullptr);
+	if (!m_impl->output)
+		return false;
+
+	if (alcIsExtensionPresent(m_impl->output, "ALC_EXT_thread_local_context")) {
+		m_impl->set_context = reinterpret_cast<SetThreadContext>(
+				alcGetProcAddress(m_impl->output, "alcSetThreadContext"));
+		m_impl->get_context = reinterpret_cast<GetThreadContext>(
+				alcGetProcAddress(m_impl->output, "alcGetThreadContext"));
+	}
+	if (m_impl->set_context && m_impl->get_context)
+		m_impl->context = alcCreateContext(m_impl->output, nullptr);
+	if (m_impl->context) {
+		ContextBinding binding(m_impl->context, m_impl->set_context, m_impl->get_context);
+		if (binding)
+			return true;
+	}
+	clearPlayback();
+	return false;
+}
+
+bool MinecloniaVoiceAudio::setMicrophone(bool enabled)
+{
+	if (!enabled) {
+		if (m_impl->microphone) {
+			alcCaptureStop(m_impl->microphone);
+			alcCaptureCloseDevice(m_impl->microphone);
+			m_impl->microphone = nullptr;
+		}
+		return true;
+	}
+	if (m_impl->microphone)
+		return true;
+
+	m_impl->microphone = alcCaptureOpenDevice(nullptr, SAMPLE_RATE, AL_FORMAT_MONO16,
+			CAPTURE_BUFFER_SAMPLES);
+	if (!m_impl->microphone)
+		return false;
+	alcCaptureStart(m_impl->microphone);
+	if (alcGetError(m_impl->microphone) != ALC_NO_ERROR) {
+		setMicrophone(false);
+		return false;
+	}
+	return true;
+}
+
+std::vector<std::string> MinecloniaVoiceAudio::capture()
+{
+	std::vector<std::string> frames;
+	if (!m_impl->microphone)
+		return frames;
+	ALCint available = 0;
+	alcGetIntegerv(m_impl->microphone, ALC_CAPTURE_SAMPLES, 1, &available);
+	available = std::clamp(available, 0, CAPTURE_BUFFER_SAMPLES);
+	// Keep partial frames in the capture device and drop old audio when a frame stalls.
+	ALCint end = available - available % SAMPLES_PER_FRAME;
+	if (!end)
+		return frames;
+	std::array<ALshort, CAPTURE_BUFFER_SAMPLES> samples;
+	alcCaptureSamples(m_impl->microphone, samples.data(), end);
+	if (alcGetError(m_impl->microphone) != ALC_NO_ERROR)
+		return frames;
+
+	ALCint begin = std::max<ALCint>(0, end - MAX_CAPTURE_SAMPLES_PER_STEP);
+	frames.reserve((end - begin) / SAMPLES_PER_FRAME);
+	for (ALCint offset = begin; offset < end; offset += SAMPLES_PER_FRAME) {
+		std::string frame(FRAME_BYTES, '\0');
+		std::transform(samples.begin() + offset, samples.begin() + offset + SAMPLES_PER_FRAME,
+				frame.begin(), encodeSample);
+		frames.push_back(std::move(frame));
+	}
+	return frames;
+}
+
+void MinecloniaVoiceAudio::receive(std::uint16_t peer, std::string_view frame)
+{
+	if (!m_impl->context || frame.size() != FRAME_BYTES)
+		return;
+	ContextBinding binding(m_impl->context, m_impl->set_context, m_impl->get_context);
+	if (!binding)
+		return;
+	auto stream = m_impl->streams.find(peer);
+	if (stream == m_impl->streams.end()) {
+		if (m_impl->streams.size() >= MAX_PLAYBACK_PEERS)
+			return;
+		stream = m_impl->streams.try_emplace(peer).first;
+		if (!stream->second.open()) {
+			m_impl->streams.erase(stream);
+			return;
+		}
+	}
+	stream->second.idle = 0;
+	stream->second.queue(frame);
+}
+
+void MinecloniaVoiceAudio::step(float dtime)
+{
+	if (m_impl->streams.empty())
+		return;
+	ContextBinding binding(m_impl->context, m_impl->set_context, m_impl->get_context);
+	if (!binding)
+		return;
+	for (auto it = m_impl->streams.begin(); it != m_impl->streams.end();) {
+		auto &stream = it->second;
+		stream.idle += dtime;
+		if (stream.idle >= 1.0f) {
+			stream.close();
+			it = m_impl->streams.erase(it);
+			continue;
+		}
+		if (stream.idle >= 0.06f) {
+			stream.update();
+			stream.start();
+		}
+		++it;
+	}
+}
+
+void MinecloniaVoiceAudio::clearPlayback()
+{
+	// Destroying the dedicated context releases every stream and queued buffer.
+	m_impl->streams.clear();
+	if (m_impl->context) {
+		alcDestroyContext(m_impl->context);
+		m_impl->context = nullptr;
+	}
+	if (m_impl->output) {
+		alcCloseDevice(m_impl->output);
+		m_impl->output = nullptr;
+	}
+	m_impl->set_context = nullptr;
+	m_impl->get_context = nullptr;
+}
+#else
+struct MinecloniaVoiceAudio::Impl {};
+
+bool MinecloniaVoiceAudio::enablePlayback() { return false; }
+bool MinecloniaVoiceAudio::setMicrophone(bool enabled) { return !enabled; }
+std::vector<std::string> MinecloniaVoiceAudio::capture() { return {}; }
+void MinecloniaVoiceAudio::receive(std::uint16_t, std::string_view) {}
+void MinecloniaVoiceAudio::step(float) {}
+void MinecloniaVoiceAudio::clearPlayback() {}
+#endif
+
+MinecloniaVoiceAudio::MinecloniaVoiceAudio() : m_impl(std::make_unique<Impl>()) {}
+
+MinecloniaVoiceAudio::~MinecloniaVoiceAudio()
+{
+	setMicrophone(false);
+	clearPlayback();
+}
