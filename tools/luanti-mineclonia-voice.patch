+	MinecloniaVoiceAudio m_audio;
+	std::map<u16, u16> m_latest_sequence;
+	u32 m_membership = 0;
+	u16 m_sequence = 0;
+	u8 m_requested_room = mineclonia_voice::QUERY;
+	float m_request_timeout = 0;
+};
