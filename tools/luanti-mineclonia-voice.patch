+struct VoiceFormspecHandler final : public TextDest
+{
+	explicit VoiceFormspecHandler(Client *client) : m_client(client)
+	{
+		m_formname = "mineclonia_voice";
+	}
+
+	void gotText(const StringMap &fields) override
+	{
+		if (fields.count("quit"))
+			return;
+		auto &voice = m_client->voice();
+		if (fields.count("voice_leave"))
+			voice.request(*m_client, 0);
+		else if (fields.count("voice_retry"))
+			voice.request(*m_client, mineclonia_voice::QUERY);
+		else if (fields.count("voice_mic"))
+			voice.toggleMicrophone();
+		else if (fields.count("voice_deafen"))
+			voice.toggleDeafen();
+		else {
+			for (u8 room = 1; room <= mineclonia_voice::ROOM_COUNT; ++room) {
+				if (fields.count("voice_join_" + std::to_string(room))) {
+					voice.request(*m_client, room);
+					break;
+				}
+			}
+		}
+	}
+
+	Client *m_client;
+};
