+bool Server::VoiceRateLimit::consume(double refill_per_second, double burst)
+{
+	const u64 now = porting::getTimeMs();
+	tokens = std::min(burst, tokens + (now - last_ms) * refill_per_second / 1000.0);
+	last_ms = now;
+	if (tokens < 1.0)
+		return false;
+	tokens -= 1.0;
+	return true;
+}
+
+Server::VoiceRoster Server::getVoiceRoster() const
+{
+	VoiceRoster roster;
+	for (const auto &[peer_id, peer] : m_voice_peers) {
+		if (peer.room != 0)
+			roster[peer.room - 1].push_back(peer_id);
+	}
+	for (auto &members : roster)
+		std::sort(members.begin(), members.end());
+	return roster;
+}
+
+void Server::sendVoiceState(session_t peer_id, const VoiceRoster &roster, u8 result)
+{
+	const VoicePeer &peer = m_voice_peers.at(peer_id);
+	NetworkPacket reply(TOCLIENT_MCL_VOICE_STATE, 0, peer_id);
+	reply << peer.room << peer.generation << result;
+	for (const auto &members : roster)
+		reply << static_cast<u8>(members.size());
+	if (peer.room != 0) {
+		for (session_t member_id : roster[peer.room - 1])
+			reply << member_id << m_voice_peers.at(member_id).name;
+	}
+	Send(&reply);
+}
+
+void Server::broadcastVoiceState(const VoiceRoster &roster)
+{
+	for (const auto &entry : m_voice_peers)
+		sendVoiceState(entry.first, roster);
+}
+
+void Server::removeVoicePeer(session_t peer_id)
+{
+	auto entry = m_voice_peers.find(peer_id);
+	if (entry == m_voice_peers.end())
+		return;
+
+	const bool was_in_room = entry->second.room != 0;
+	m_voice_peers.erase(entry);
+	if (was_in_room)
+		broadcastVoiceState(getVoiceRoster());
+}
+
+void Server::handleCommand_MclVoiceControl(NetworkPacket *pkt)
+{
+	using namespace mineclonia_voice;
+	if (!m_voice_enabled || pkt->getSize() != sizeof(u8))
+		return;
+
+	u8 requested_room;
+	*pkt >> requested_room;
+	if (requested_room != QUERY && requested_room > ROOM_COUNT)
+		return;
+
+	const session_t peer_id = pkt->getPeerId();
+	auto entry = m_voice_peers.find(peer_id);
+	if (entry == m_voice_peers.end()) {
+		if (requested_room != QUERY)
+			return;
+		const RemotePlayer *player = m_env->getPlayer(peer_id);
+		if (!player)
+			return;
+		entry = m_voice_peers.try_emplace(peer_id, VoicePeer{player->getName()}).first;
+	}
+
+	VoicePeer &peer = entry->second;
+	const bool leaving = requested_room == 0 && peer.room != 0;
+	if (!peer.control_budget.consume(4.0, 4.0) && !leaving)
+		return;
+
+	const auto roster = getVoiceRoster();
+	if (requested_room == QUERY || requested_room == peer.room) {
+		sendVoiceState(peer_id, roster);
+		return;
+	}
+	if (requested_room != 0 && roster[requested_room - 1].size() >= ROOM_CAPACITY) {
+		sendVoiceState(peer_id, roster, ROOM_FULL);
+		return;
+	}
+
+	peer.room = requested_room;
+	if (++m_voice_generation == 0)
+		++m_voice_generation;
+	peer.generation = m_voice_generation;
+	broadcastVoiceState(getVoiceRoster());
+}
+
+void Server::handleCommand_MclVoiceAudio(NetworkPacket *pkt)
+{
+	using namespace mineclonia_voice;
+	if (!m_voice_enabled || pkt->getSize() != sizeof(u32) + sizeof(u16) + FRAME_BYTES)
+		return;
+
+	const session_t sender_id = pkt->getPeerId();
+	const auto entry = m_voice_peers.find(sender_id);
+	if (entry == m_voice_peers.end() || entry->second.room == 0)
+		return;
+
+	u32 generation;
+	u16 sequence;
+	*pkt >> generation >> sequence;
+	VoicePeer &sender = entry->second;
+	if (generation != sender.generation || !sender.audio_budget.consume(55.0, 8.0))
+		return;
+
+	for (const auto &[peer_id, peer] : m_voice_peers) {
+		if (peer_id == sender_id || peer.room != sender.room)
+			continue;
+		NetworkPacket frame(TOCLIENT_MCL_VOICE_AUDIO,
+				sizeof(u32) + 2 * sizeof(u16) + FRAME_BYTES, peer_id);
+		frame << peer.generation << sender_id << sequence;
+		frame.putRawString(pkt->getRemainingNoCopy());
+		Send(&frame);
+	}
+}
