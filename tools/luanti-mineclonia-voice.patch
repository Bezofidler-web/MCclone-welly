diff --git a/src/client/mineclonia_voice_client.cpp b/src/client/mineclonia_voice_client.cpp
new file mode 100644
index 0000000..4aa67b5
--- /dev/null
+++ b/src/client/mineclonia_voice_client.cpp
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+
+#include "mineclonia_voice_client.h"
+#include "client.h"
+#include "config.h"
+#include "network/networkpacket.h"
+#include "settings.h"
+#include <algorithm>
+
+using namespace mineclonia_voice;
+
+static_assert(FRAME_BYTES == MinecloniaVoiceAudio::FRAME_BYTES);
+
+void MinecloniaVoiceClient::advertise()
+{
+	available = USE_SOUND;
+}
+
+void MinecloniaVoiceClient::request(Client &client, u8 target)
+{
+	if (!available || busy() || (target != QUERY && (!ready || target == room)))
+		return;
+	if (target != QUERY) {
+		setMicrophone(false);
+		m_audio.clearPlayback();
+		playback_ready = false;
+	}
+	m_requested_room = target;
+	m_request_timeout = 5.0f;
+	status = target == QUERY ? Status::Loading : Status::Pending;
+	NetworkPacket packet(TOSERVER_MCL_VOICE_CONTROL, 1);
+	packet << target;
+	client.Send(&packet);
+}
+
+void MinecloniaVoiceClient::receiveState(NetworkPacket &packet)
+{
+	if (!available || packet.getSize() < 6 + ROOM_COUNT || packet.getSize() > 512)
+		return;
+
+	u8 new_room, result;
+	u32 membership;
+	std::array<u8, ROOM_COUNT> new_counts{};
+	packet >> new_room >> membership >> result;
+	if (new_room > ROOM_COUNT || result > ROOM_FULL)
+		return;
+	for (u8 &count : new_counts) {
+		packet >> count;
+		if (count > ROOM_CAPACITY)
+			return;
+	}
+	std::map<u16, std::string> new_members;
+	const u8 count = new_room ? new_counts[new_room - 1] : 0;
+	for (u8 i = 0; i < count; ++i) {
+		u16 peer;
+		std::string name;
+		packet >> peer >> name;
+		if (name.empty() || !new_members.emplace(peer, std::move(name)).second)
+			return;
+	}
+	if (packet.hasRemainingBytes() || (new_room && (!count || !membership)))
+		return;
+
+	const bool moved = room != new_room || m_membership != membership;
+	if (moved) {
+		setMicrophone(false);
+		m_audio.clearPlayback();
+		playback_ready = false;
+		m_latest_sequence.clear();
+		m_membership = membership;
+		room = new_room;
+	} else {
+		for (auto it = m_latest_sequence.begin(); it != m_latest_sequence.end();) {
+			if (new_members.count(it->first))
+				++it;
+			else
+				it = m_latest_sequence.erase(it);
+		}
+	}
+	counts = new_counts;
+	members = std::move(new_members);
+	ready = true;
+	if (busy() && (m_requested_room == QUERY || room == m_requested_room || result == ROOM_FULL)) {
+		const bool just_joined = moved && room && room == m_requested_room && result == 0;
+		m_request_timeout = 0;
+		m_requested_room = QUERY;
+		status = result == ROOM_FULL ? Status::Full : Status::None;
+		if (just_joined)
+			setMicrophone(true);
+	}
+	if (!busy() && room && !deafened && !playback_ready && (moved || result == ROOM_FULL))
+		playback_ready = m_audio.enablePlayback();
+}
+
+void MinecloniaVoiceClient::receiveAudio(NetworkPacket &packet)
+{
+	if (!room || busy() || deafened || !playback_ready || g_settings->getBool("mute_sound") ||
+			packet.getSize() != 8 + FRAME_BYTES)
+		return;
+	u32 membership;
+	u16 peer, sequence;
+	packet >> membership >> peer >> sequence;
+	if (membership != m_membership || !members.count(peer))
+		return;
+	auto [it, inserted] = m_latest_sequence.try_emplace(peer, sequence);
+	if (!inserted) {
+		const u16 delta = sequence - it->second;
+		if (delta == 0 || delta >= 0x8000)
+			return;
+		it->second = sequence;
+	}
+	m_audio.receive(peer, packet.getRemainingNoCopy());
+}
+
+void MinecloniaVoiceClient::setMicrophone(bool enabled)
+{
+	if (enabled != transmitting)
+		transmitting = m_audio.setMicrophone(enabled) && enabled;
+	microphone_error = enabled && !transmitting;
+}
+
+void MinecloniaVoiceClient::step(Client &client, float dtime)
+{
+	if (!available)
+		return;
+	if (busy()) {
+		m_request_timeout = std::max(0.0f, m_request_timeout - dtime);
+		if (!busy()) {
+			m_requested_room = QUERY;
+			status = Status::TimedOut;
+			playback_ready = room && !deafened && m_audio.enablePlayback();
+		}
+	}
+	if (room)
+		m_audio.step(dtime);
+	if (!transmitting)
+		return;
+	for (const auto &frame : m_audio.capture()) {
+		NetworkPacket packet(TOSERVER_MCL_VOICE_AUDIO, 6 + FRAME_BYTES);
+		packet << m_membership << m_sequence++;
+		packet.putRawString(frame);
+		client.Send(&packet);
+	}
+}
+
+void MinecloniaVoiceClient::toggleMicrophone()
+{
+	if (room && !busy())
+		setMicrophone(!transmitting);
+}
+
+void MinecloniaVoiceClient::toggleDeafen()
+{
+	if (!room || busy())
+		return;
+	deafened = !deafened;
+	if (deafened)
+		m_audio.clearPlayback();
+	playback_ready = !deafened && m_audio.enablePlayback();
+}
+
+void MinecloniaVoiceClient::stop()
+{
+	setMicrophone(false);
+	m_audio.clearPlayback();
+	playback_ready = false;
+}
