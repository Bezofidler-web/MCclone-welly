+	m_java_loading_cancel = false;
+}
+
+void RenderingEngine::draw_java_load_screen(const std::wstring &text, gui::IGUIEnvironment *guienv,
+		ITextureSource *tsrc, int percent, const std::wstring &bottom_text,
+		LoadingScreenStyle style, Client *level)
+{
+	auto *driver = get_video_driver();
+	const auto size_unsigned = driver->getScreenSize();
+	const v2s32 size(size_unsigned.Width, size_unsigned.Height);
+	const core::rect<s32> screen(v2s32(0, 0), size);
+	const s32 scale = java_loading_scale(size);
+	const v2s32 center = size / scale / 2 * scale;
+
+	if (style == LoadingScreenStyle::Connecting) {
+		if (!m_java_loading_controls)
+			m_java_loading_controls.reset(new JavaLoadingControls(guienv, tsrc, m_java_loading_cancel));
+	} else {
+		clear_java_loading_controls();
+	}
+
+	driver->beginScene(true, true, video::SColor(255, 25, 23, 29));
+	draw_java_loading_panorama(driver, tsrc, screen);
+
+	const bool have_terrain = style == LoadingScreenStyle::Terrain &&
+			level && level->getEnv().getLocalPlayer();
+	FontSpec font_spec(java_loading_font_size(scale), FM_Standard, false, false);
+	font_spec.allow_server_media = false;
+	auto *font = g_fontengine->getFont(font_spec);
+	const s32 line_height = g_fontengine->getLineHeight(font_spec);
+	s32 text_y = center.Y - line_height / 2;
+	if (have_terrain) {
+		draw_java_loading_map(driver, *level, center, scale);
+		text_y = center.Y - (JAVA_TERRAIN_RADIUS * 2 + 27) * scale;
+	} else if (style == LoadingScreenStyle::Connecting ||
+			style == LoadingScreenStyle::Terrain || style == LoadingScreenStyle::Resources) {
+		text_y = center.Y - 50 * scale;
+	}
+	text_y = std::max(text_y, 2 * scale);
+
+	font->draw(text.c_str(), core::rect<s32>(0, text_y, center.X * 2, text_y + line_height),
+			video::SColor(0xffffffff), true, false, &screen);
+
+	const bool show_progress = (style == LoadingScreenStyle::Terrain ||
+			style == LoadingScreenStyle::Resources) && percent >= 0 && percent <= 100;
+	const s32 bar_y = text_y + std::max(12 * scale, line_height + 3 * scale);
+	if (show_progress) {
+		const s32 width = std::min(200 * scale, size.X);
+		const s32 x = std::max(0, center.X - width / 2);
+		driver->draw2DRectangle(video::SColor(0xff000000),
+				core::rect<s32>(x, bar_y, x + width, bar_y + 2 * scale));
+		const s32 fill_width = (width * percent + 50) / 100;
+		if (fill_width > 0)
+			driver->draw2DRectangle(video::SColor(0xff00ff00),
+					core::rect<s32>(x, bar_y, x + fill_width, bar_y + 2 * scale));
+	}
+
+	if (!bottom_text.empty()) {
+		const s32 details_y = bar_y + 8 * scale;
+		font->draw(bottom_text.c_str(), core::rect<s32>(0, details_y, center.X * 2, size.Y),
+				video::SColor(0xffe0e0e0), true, false, &screen);
+	}
+	guienv->drawAll();
+	driver->endScene();
+}
