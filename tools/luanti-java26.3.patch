--- /dev/null
+++ b/client/shaders/mcl_pause_blur_h/opengl_fragment.glsl
@@ -0,0 +1,14 @@
+uniform sampler2D texture0;
+uniform vec2 texelSize0;
+CENTROID_ VARYING_ mediump vec2 varTexCoord;
+
+void main(void)
+{
+	vec2 direction = vec2(texelSize0.x, 0.0);
+	vec3 colour = texture2D(texture0, varTexCoord + direction * 5.0).rgb * 0.5;
+	for (int pair = 0; pair < 5; ++pair) {
+		float offset = 2.0 * float(pair) - 4.5;
+		colour += texture2D(texture0, varTexCoord + direction * offset).rgb;
+	}
+	gl_FragColor = vec4(colour / 5.5, 1.0);
+}
