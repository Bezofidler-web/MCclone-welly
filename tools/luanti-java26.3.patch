+
+void GUIChatConsole::prepareJavaFont(s32 scale)
+{
+	if (m_java_font && m_java_font_scale == scale)
+		return;
+
+	const f32 density = RenderingEngine::getDisplayDensity() *
+			g_settings->getFloat("gui_scaling", 0.5f, 20.0f);
+	const u16 configured = g_settings->getU16("chat_font_size");
+	const s32 size = configured != 0 ? rangelim(configured, 5, 72) :
+			std::max(1, myround(9 * scale / density));
+	m_java_font.grab(g_fontengine->getFont(size, FM_Mono));
+	m_java_glyph_width = std::max(1U, m_java_font->getDimension(L"M").Width);
+	m_java_font_height = configured != 0 ? m_java_font->getDimension(L"Ay").Height : 0;
+	m_java_font_scale = scale;
+}
+
+void GUIChatConsole::drawJavaChatLine(const ChatFormattedLine &line,
+		const core::recti &row, s32 scale, float fade)
+{
+	if (line.fragments.empty())
+		return;
+
+	auto *driver = Environment->getVideoDriver();
+	driver->draw2DRectangle(video::SColor(127 * fade, 0, 0, 0), row);
+	for (const ChatFormattedFragment &fragment : line.fragments) {
+		const s32 x = 4 * scale + fragment.column * m_java_glyph_width;
+		const core::recti dest(v2s32(x, row.UpperLeftCorner.Y), row.LowerRightCorner);
+		if (m_java_font->getType() == gui::EGFT_CUSTOM) {
+			auto *font = static_cast<gui::CGUITTFont *>(m_java_font.get());
+			if (fade == 1.0f) {
+				font->draw(fragment.text, dest, false, false, &row);
+			} else {
+				auto colors = fragment.text.getColors();
+				for (auto &color : colors)
+					color.setAlpha(color.getAlpha() * fade);
+				font->draw(EnrichedString(fragment.text.getString(), colors), dest, false, false, &row);
+			}
+		} else {
+			m_java_font->draw(fragment.text.c_str(), dest,
+					video::SColor(255 * fade, 255, 255, 255), false, false, &row);
+		}
+	}
+}
+
+void GUIChatConsole::drawJavaRecentChat(bool messages_changed)
+{
+	const v2u32 screen = Environment->getVideoDriver()->getScreenSize();
+	prepareJavaFont(JavaChatLayout::screenScale(screen));
+	const JavaChatLayout layout(screen, m_java_font_height);
+	const s32 cols = layout.width / m_java_glyph_width;
+	const auto &buffer = m_chat_backend->getRecentBuffer();
+	if (messages_changed || cols != m_java_recent_columns) {
+		m_java_recent_columns = cols;
+		m_java_recent_rows.clear();
+		std::vector<ChatFormattedLine> formatted;
+		constexpr size_t max_rows = 10;
+		for (u32 index = buffer.getLineCount(); index > 0 && cols > 0 &&
+				m_java_recent_rows.size() < max_rows;) {
+			formatted.clear();
+			buffer.formatChatLine(buffer.getLine(--index), cols, formatted);
+			for (auto line = formatted.rbegin(); line != formatted.rend() &&
+					m_java_recent_rows.size() < max_rows; ++line)
+				m_java_recent_rows.emplace_back(index, std::move(*line));
+		}
+	}
+
+	s32 y = layout.bottom;
+	s32 remaining = layout.rows(false);
+	for (const auto &[index, line] : m_java_recent_rows) {
+		if (remaining <= 0)
+			break;
+		const float opacity = std::clamp(10.0f - buffer.getLine(index).age, 0.0f, 1.0f);
+		const float fade = opacity * opacity;
+		if (255 * fade <= 3)
+			break;
+		y -= layout.line_height;
+		drawJavaChatLine(line, layout.rowBounds(y), layout.scale, fade);
+		--remaining;
+	}
+}
+
+void GUIChatConsole::drawJavaChat()
+{
+	const JavaChatLayout layout(m_screensize, m_java_font_height);
+	auto &buffer = m_chat_backend->getConsoleBuffer();
+	const s32 rows = buffer.getRows();
+	for (s32 row = 0; row < rows; ++row) {
+		const s32 y = layout.bottom - (rows - row) * layout.line_height;
+		drawJavaChatLine(buffer.getFormattedLine(row), layout.rowBounds(y), layout.scale, 1.0f);
+	}
+
+	const s32 range = buffer.getBottomScrollPos() - buffer.getTopScrollPos();
+	if (range > 0 && rows > 0) {
+		const s32 track = rows * layout.line_height;
+		const s32 thumb = std::max(layout.scale, track * rows / (rows + range));
+		const s32 offset = (track - thumb) * (buffer.getScrollPosition() -
+				buffer.getTopScrollPos()) / range;
+		const s32 x = layout.width + 10 * layout.scale;
+		const s32 y = layout.bottom - track + offset;
+		Environment->getVideoDriver()->draw2DRectangle(video::SColor(170, 204, 204, 204),
+				core::recti(x, y, x + 2 * layout.scale, y + thumb));
+	}
+
+	drawJavaPrompt(layout.prompt, layout.scale, layout.line_height);
+}
+
+void GUIChatConsole::drawJavaPrompt(const core::recti &bounds, s32 scale, s32 line_height)
+{
+	if (!bounds.isValid())
+		return;
+	auto *driver = Environment->getVideoDriver();
+	driver->draw2DRectangle(video::SColor(127, 0, 0, 0), bounds);
+
+	const auto &prompt = m_chat_backend->getPrompt();
+	const std::wstring text = prompt.getVisiblePortion();
+	const s32 left = 4 * scale;
+	const s32 top = bounds.UpperLeftCorner.Y + 2 * scale;
+	const s32 bottom = top + line_height;
+	const s32 cursor = std::clamp(prompt.getVisibleCursorPosition(), 0, static_cast<s32>(text.size()));
+	const s32 x = left + m_java_font->getDimension(text.substr(0, cursor).c_str()).Width;
+	const s32 selection_end = std::min(static_cast<s32>(text.size()), cursor + prompt.getCursorLength());
+	if (selection_end > cursor) {
+		const s32 right = left + m_java_font->getDimension(text.substr(0, selection_end).c_str()).Width;
+		driver->draw2DRectangle(video::SColor(255, 0, 0, 255), core::recti(x, top, right, bottom),
+				&bounds);
+	}
+	m_java_font->draw(text.c_str(), core::recti(left, top, bounds.LowerRightCorner.X, bottom),
+			video::SColor(0xffffffff), false, false, &bounds);
+	if ((m_cursor_blink & 0x8000) != 0) {
+		const auto caret = cursor == static_cast<s32>(text.size()) ?
+				core::recti(x, bottom - scale, x + m_java_glyph_width, bottom) :
+				core::recti(x, top, x + scale, bottom);
+		driver->draw2DRectangle(video::SColor(0xffffffff), caret, &bounds);
+	}
+}
