+// SPDX-License-Identifier: LGPL-2.1-or-later
+#include "java_debug.h"
+
+#include <algorithm>
+#include <cmath>
+#include <iomanip>
+#include <locale>
+#include <sstream>
+#include <vector>
+#include <IGUIFont.h>
+#include <IVideoDriver.h>
+#include "client.h"
+#include "clientmap.h"
+#include "fontengine.h"
+#include "hud_element.h"
+#include "localplayer.h"
+#include "nodedef.h"
+#include "renderingengine.h"
+#include "settings.h"
+#include "util/numeric.h"
+#include "util/pointedthing.h"
+#include "version.h"
+
+namespace {
+
+struct Dimension {
+	const char *name = nullptr;
+	int offset = 0;
+};
+
+// The server sends its exact dimension boundaries as HUD metadata. Mineclonia
+// worlds created with different generators have different vertical origins.
+Dimension getDimension(const LocalPlayer &player, double y)
+{
+	for (const auto &element : player.hud.getElements()) {
+		if (!element || element->name != "mcl_info:java_debug_bounds_v1")
+			continue;
+		int overworld_min, overworld_origin, nether_min, nether_max, end_min, end_max;
+		std::istringstream bounds(element->text);
+		if (!(bounds >> overworld_min >> overworld_origin >>
+				nether_min >> nether_max >> end_min >> end_max))
+			break;
+		if (y >= overworld_min)
+			return {"minecraft:overworld", overworld_origin};
+		if (y >= nether_min && y <= nether_max)
+			return {"minecraft:the_nether", nether_min};
+		if (y >= end_min && y <= end_max)
+			return {"minecraft:the_end", end_min};
+		return {"Mineclonia void", 0};
+	}
+	return {};
+}
+
+std::string blockPosition(int x, int y, int z)
+{
+	return std::to_string(x) + " " + std::to_string(y) + " " + std::to_string(z);
+}
+
+void drawLines(video::IVideoDriver &driver, gui::IGUIFont &font,
+		const std::vector<std::string> &lines, int scale, bool right)
+{
+	const v2u32 screen = driver.getScreenSize();
+	const int padding = 2 * scale;
+	const int line_height = 9 * scale;
+	int y = padding;
+	for (const auto &line : lines) {
+		if (y + line_height > static_cast<int>(screen.Y))
+			break;
+		if (!line.empty()) {
+			std::wstring text = utf8_to_wide(line);
+			const int width = font.getDimension(text.c_str()).Width;
+			const int x = right ? static_cast<int>(screen.X) - padding - width : padding;
+			if (!right || x >= static_cast<int>(screen.X) / 2) {
+				driver.draw2DRectangle(video::SColor(0x90505050),
+						core::rect<s32>(x - scale, y - scale, x + width + scale, y + line_height - scale));
+				font.draw(text.c_str(), core::rect<s32>(x, y, x + width, y + line_height),
+						video::SColor(0xFFE0E0E0));
+			}
+		}
+		y += line_height;
+	}
+}
+
+} // namespace
+
+void drawJavaDebugOverlay(Client &client, video::IVideoDriver &driver,
+		const PointedThing &pointed, float average_frame_time)
+{
+	const v2u32 screen = driver.getScreenSize();
+	// Debug GUI scale Auto uses a smaller integer scale than the main GUI.
+	const int scale = std::max(1, static_cast<int>(std::min(screen.X / 320, screen.Y / 240)) / 2);
+	const float density = RenderingEngine::getDisplayDensity() *
+			g_settings->getFloat("gui_scaling", 0.5f, 20.0f);
+	FontSpec font_spec(std::max(1, static_cast<int>(std::lround(9 * scale / density))),
+			FM_Standard, false, false);
+	font_spec.allow_server_media = false;
+	auto *font = g_fontengine->getFont(font_spec);
+
+	const auto &player = *client.getEnv().getLocalPlayer();
+	const int fps = average_frame_time > 0.0f ? std::lround(1.0f / average_frame_time) : 0;
+	std::vector<std::string> left = {
+		std::string("Mineclonia (Luanti ") + g_version_hash + ")",
+		std::to_string(fps) + " fps",
+		"",
+	};
+	std::vector<std::string> right = {
+		"Display: " + std::to_string(screen.X) + "x" + std::to_string(screen.Y) +
+				" (" + driver.getVendorInfo().c_str() + ")",
+		driver.getName(),
+	};
+	if (client.checkPrivilege("debug") || (player.hud_flags & HUD_FLAG_BASIC_DEBUG)) {
+		const v3f pos = player.getPosition() / BS;
+		const Dimension dimension = getDimension(player, pos.Y + 0.5);
+		const double x = pos.X + 0.5;
+		const double y = pos.Y + 0.5 - dimension.offset;
+		const double z = 0.5 - pos.Z;
+		const int bx = std::floor(x), by = std::floor(y), bz = std::floor(z);
+		std::ostringstream xyz;
+		xyz.imbue(std::locale::classic());
+		xyz << "XYZ: " << std::fixed << std::setprecision(3) << x << " / "
+				<< std::setprecision(5) << y << " / " << std::setprecision(3) << z;
+		left.emplace_back(xyz.str());
+		left.emplace_back("Block: " + blockPosition(bx, by, bz));
+		left.emplace_back("Chunk: " + blockPosition(std::floor(bx / 16.0),
+				std::floor(by / 16.0), std::floor(bz / 16.0)));
+
+		const double rotation = wrapDegrees_0_360(-player.getYaw());
+		const double yaw = rotation - 180.0;
+		const char *const directions[] = {"north", "east", "south", "west"};
+		const char *const axes[] = {"negative Z", "positive X", "positive Z", "negative X"};
+		const int direction = static_cast<int>(std::floor(rotation / 90.0 + 0.5)) % 4;
+		std::ostringstream facing;
+		facing.imbue(std::locale::classic());
+		facing << "Facing: " << directions[direction] << " (Towards " << axes[direction] << ") ("
+				<< std::fixed << std::setprecision(1) << yaw << " / " << player.getPitch() << ")";
+		left.emplace_back(facing.str());
+		if (dimension.name)
+			left.emplace_back(dimension.name);
+
+		if (pointed.type == POINTEDTHING_NODE) {
+			const v3s16 p = pointed.node_undersurface;
+			const MapNode node = client.getEnv().getClientMap().getNode(p);
+			if (node.getContent() != CONTENT_IGNORE) {
+				right.emplace_back();
+				right.emplace_back("Targeted Block: " + blockPosition(p.X,
+						p.Y - getDimension(player, p.Y).offset, -p.Z));
+				right.emplace_back(client.getNodeDefManager()->get(node).name);
+			}
+		}
+	}
+
+	drawLines(driver, *font, left, scale, false);
+	drawLines(driver, *font, right, scale, true);
+}
