+void draw_java_loading_panorama(video::IVideoDriver *driver, ITextureSource *tsrc,
+		const core::rect<s32> &screen)
+{
+	if (!tsrc || !screen.getArea())
+		return;
+	const char *name = "mcl_menu_panorama.png";
+	if (!tsrc->isKnownSourceImage(name))
+		name = "mcl_java_loading_panorama.png";
+	if (!tsrc->isKnownSourceImage(name))
+		return;
+	auto *texture = tsrc->getTexture(name);
+	if (!texture)
+		return;
+	const auto texture_size = texture->getSize();
+	if (texture_size.Width < 2 || texture_size.Height < 2)
+		return;
+
+	// Fill the window without distorting the artwork.
+	const float aspect = (float)screen.getWidth() / screen.getHeight();
+	const s32 crop_w = std::min<s32>(texture_size.Width, texture_size.Height * aspect);
+	const s32 crop_h = std::min<s32>(texture_size.Height, texture_size.Width / aspect);
+	const s32 x = ((s32)texture_size.Width - crop_w) / 2;
+	const s32 y = ((s32)texture_size.Height - crop_h) / 2;
+	draw2DImageFilterScaled(driver, texture, screen, {x, y, x + crop_w, y + crop_h});
+	driver->draw2DRectangle(video::SColor(64, 0, 0, 0), screen);
+}
+
+void draw_java_loading_map(video::IVideoDriver *driver, Client &client,
+		v2s32 center, s32 scale)
+{
+	auto &environment = client.getEnv();
+	auto &map = environment.getClientMap();
+	const auto *player = environment.getLocalPlayer();
+	const v3s16 origin = getContainerPos(floatToInt(player->getPosition(), BS), MAP_BLOCKSIZE);
+	constexpr s32 diameter = JAVA_TERRAIN_RADIUS * 2 + 1;
+	const s32 size = 2 * scale;
+	const v2s32 start = center - v2s32(diameter * size / 2, diameter * size / 2);
+	driver->draw2DRectangle(video::SColor(0xff000000),
+			core::rect<s32>(start, start + v2s32(diameter * size, diameter * size)));
+	for (s32 row = 0; row < diameter; ++row) {
+		for (s32 column = 0; column < diameter; ++column) {
+			// Java south is +Z and Luanti north is +Z.
+			const v3s16 pos(origin.X + column - JAVA_TERRAIN_RADIUS, origin.Y,
+					origin.Z - row + JAVA_TERRAIN_RADIUS);
+			auto *block = map.getBlockNoCreateNoEx(pos);
+			if (!block || (!block->mesh && !block->isGenerated()))
+				continue;
+			const u32 colour = block->mesh ? 0xffffffff : 0xff303572;
+			const v2s32 cell_start = start + v2s32(column * size, row * size);
+			driver->draw2DRectangle(video::SColor(colour),
+					core::rect<s32>(cell_start, cell_start + v2s32(size, size)));
+		}
+	}
+}
+
