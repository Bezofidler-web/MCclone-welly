+		m_textures(textures), m_local_game(local_game)
+	{
+	}
+
+	void setOptions(bool options)
+	{
+		m_options = options;
+		m_form.clear();
+	}
+
+	bool isOptions() const { return m_options; }
+
+	const std::string &getForm() const override
+	{
+		const v2u32 screen = RenderingEngine::get_video_driver()->getScreenSize();
+		const float density = RenderingEngine::getDisplayDensity() * g_settings->getFloat("gui_scaling");
+		if (!m_form.empty() && screen == m_screen && density == m_density)
+			return m_form;
+
+		m_screen = screen;
+		m_density = density;
+		// Match Java's automatic GUI scaling and logical-pixel layout.
+		const s32 scale = std::max<u32>(1, std::min(screen.X / 320, screen.Y / 240));
+		const s32 width = (screen.X + scale - 1) / scale;
+		const s32 height = (screen.Y + scale - 1) / scale;
+		constexpr s32 full = 204;
+		constexpr s32 half = 98;
+		constexpr s32 row = 24;
+		constexpr s32 button_height = 20;
+		const s32 left = (width - full) / 2;
+		const s32 right = left + half + 8;
+		// Java's grid has 50px top padding and four rows with 4px top padding.
+		const s32 top = (height - (50 + button_height + 4 * row)) / 4 + 50;
+		const s32 font_size = std::max(1, static_cast<int>(std::lround(8 * scale /
+				std::max(0.01f, density))));
+
+		const std::string normal = buttonTexture("mcl_options_button.png", scale);
+		const std::string active = buttonTexture("mcl_options_button_highlighted.png", scale);
+		std::ostringstream os;
+		// A fullscreen form with zero padding has one physical pixel per unit.
+		os << "formspec_version[8]size[" << screen.X << ',' << screen.Y
+			<< "]position[0,0]anchor[0,0]padding[0,0]no_prepend[]bgcolor[;true;#00000040]"
+			<< "style_type[button,image_button;border=false;bgimg="
+			<< normal << ";bgimg_middle=" << 3 * scale << ";textcolor=#FFFFFF;font_size="
+			<< font_size << ']'
+			<< "style_type[button:hovered,button:focused,button:pressed,"
+			   "image_button:hovered,image_button:focused,image_button:pressed;bgimg="
+			<< active << ']'
+			<< "style_type[label;halign=center;valign=center;textcolor=#FFFFFF;font_size="
+			<< font_size << ']'
+			<< "label[0," << 40 * scale << ';' << screen.X << ',' << 9 * scale << ';'
+			<< escaped(m_options ? gettext("Options") : gettext("Game Menu")) << ']';
+
+		auto button = [&](s32 x, s32 y, s32 w, const char *name, const char *label, bool exit = false) {
+			os << (exit ? "button_exit[" : "button[") << x * scale << ',' << y * scale
+				<< ';' << w * scale << ',' << button_height * scale << ';' << name << ';'
+				<< escaped(label) << ']';
+		};
+		auto icon = [&](s32 x, const char *name, const char *texture, const char *label, bool exit = false) {
+			os << (exit ? "image_button_exit[" : "image_button[") << x * scale << ','
+				<< (top + 2 * row) * scale << ';' << button_height * scale << ','
+				<< button_height * scale << ';' << texture << ';' << name << ";]"
+				<< "tooltip[" << name << ';' << escaped(label) << ']';
+		};
+
+		if (m_options) {
+			os << "allow_close[false]";
+			button(left, top, full, "btn_settings", gettext("Client Settings..."));
+#if !defined(__ANDROID__) && USE_SOUND
+			button(left, top + row, full, "btn_sound", gettext("Music & Sounds..."));
+#endif
+			if (!m_local_game)
+				button(left, top + 2 * row, full, "btn_change_password", gettext("Change Password"));
+			button(left, top + 3 * row, full, "btn_exit_os", gettext("Exit to Desktop"));
+			button(left, top + 4 * row, full, "btn_java_options_back", gettext("Done"));
+		} else {
+			const s32 icons_left = (width - (4 * button_height + 3 * 4)) / 2;
+			button(left, top, full, "btn_continue", gettext("Back to Game"), true);
+			button(left, top + row, half, "btn_java_advancements", gettext("Advancements"), true);
+			button(right, top + row, half, "btn_java_stats", gettext("Statistics"), true);
+			icon(icons_left, "btn_java_bugs", "mcl_java_pause_bug.png", gettext("Report Bugs"));
+			icon(icons_left + row, "btn_java_feedback", "mcl_java_pause_feedback.png", gettext("Give Feedback"));
+			icon(icons_left + 2 * row, "btn_java_players", "mcl_java_pause_friends.png", gettext("Players"), true);
+			if (!m_local_game) {
+				icon(icons_left + 3 * row, "btn_java_server", "mcl_java_pause_server.png",
+					gettext("Server Controls"), true);
+			} else {
+				const s32 x = (icons_left + 3 * row) * scale;
+				const s32 y = (top + 2 * row) * scale;
+				os << "image[" << x << ',' << y << ';' << button_height * scale << ','
+					<< button_height * scale << ";mcl_options_button.png^[multiply:#686868]"
+					<< "image[" << x + 3 * scale << ',' << y + 3 * scale << ';'
+					<< 14 * scale << ',' << 14 * scale << ";mcl_java_pause_server.png^[multiply:#686868]";
+			}
+			button(left, top + 3 * row, half, "btn_java_options", gettext("Options..."));
+			button(right, top + 3 * row, half, "btn_java_world", gettext("World Options..."), true);
+			button(left, top + 4 * row, full, "btn_exit_menu",
+				m_local_game ? gettext("Save and Quit to Title") : gettext("Disconnect"), true);
+		}
+
+		m_form = os.str();
+		return m_form;
+	}
+
+private:
+	static std::string escaped(const char *label)
+	{
+		std::string result = label;
+		str_formspec_escape(result);
+		return result;
+	}
+
+	std::string buttonTexture(const char *name, s32 scale) const
+	{
+		const auto *texture = m_textures->getTexture(name);
+		if (!texture || scale == 1)
+			return name;
+		const auto size = texture->getOriginalSize();
+		return std::string(name) + "^[resize:" + std::to_string(size.Width * scale) +
+				'x' + std::to_string(size.Height * scale);
+	}
+
+	ITextureSource *m_textures;
+	const bool m_local_game;
+	bool m_options = false;
+	mutable v2u32 m_screen;
+	mutable float m_density = 0.0f;
+	mutable std::string m_form;
+};
+
+struct JavaPauseFormspecHandler final : public HardcodedPauseFormspecHandler
+{
+	JavaPauseFormspecHandler(Client *client, JavaPauseFormSource *source) :
+		m_client(client), m_source(source)
+	{
+	}
+
+	void gotText(const StringMap &fields) override
+	{
+		if (fields.count("btn_java_options"))
+			m_source->setOptions(true);
+		else if (fields.count("btn_java_options_back") ||
+				(m_source->isOptions() && fields.count("try_quit")))
+			m_source->setOptions(false);
+		else if (fields.count("btn_java_advancements"))
+			m_client->sendChatMessage(L"/awards");
+		else if (fields.count("btn_java_stats"))
+			m_client->sendChatMessage(L"/mcl_java_pause statistics");
+		else if (fields.count("btn_java_players"))
+			m_client->sendChatMessage(L"/players");
+		else if (fields.count("btn_java_server"))
+			m_client->sendChatMessage(L"/mcl_java_pause server");
+		else if (fields.count("btn_java_world"))
+			m_client->sendChatMessage(L"/mcl_java_pause world");
+		else if (fields.count("btn_java_bugs"))
+			g_gamecallback->showOpenURLDialog("https://codeberg.org/mineclonia/mineclonia/issues");
+		else if (fields.count("btn_java_feedback"))
+			g_gamecallback->showOpenURLDialog("https://content.luanti.org/packages/ryvnf/mineclonia/");
+		else
+			HardcodedPauseFormspecHandler::gotText(fields);
+	}
+
+	Client *m_client;
+	JavaPauseFormSource *m_source;
+};
