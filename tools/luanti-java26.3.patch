+void DrawHUD::drawJavaPauseBackdrop(PipelineContext &context)
+{
+	auto *menu = g_menumgr.tryGetTopMenu();
+	if (!menu || !menu->pausesGame() || !menu->getName() ||
+			std::string_view(menu->getName()) != "mcl_java_pause")
+		return;
+	auto *driver = context.device->getVideoDriver();
+	if (driver->getDriverType() != video::EDT_OPENGL3 || g_settings->get("3d_mode") != "none")
+		return;
+
+	if (!m_java_pause_blur_checked) {
+		m_java_pause_blur_checked = true;
+		auto *shaders = context.client->getShaderSource();
+		try {
+			const u32 horizontal = shaders->getShaderRaw("mcl_pause_blur_h");
+			const u32 vertical = shaders->getShaderRaw("mcl_pause_blur_v");
+			const auto h_material = shaders->getShaderInfo(horizontal).material;
+			const auto v_material = shaders->getShaderInfo(vertical).material;
+			if (h_material != video::EMT_INVALID && h_material >= video::numBuiltInMaterials &&
+					v_material != video::EMT_INVALID && v_material >= video::numBuiltInMaterials)
+				m_java_pause_blur = std::make_unique<JavaPauseBlur>(horizontal, vertical);
+		} catch (const ShaderException &e) {
+			warningstream << "Java pause background blur unavailable: " << e.what() << std::endl;
+		}
+	}
+	if (m_java_pause_blur)
+		m_java_pause_blur->run(context);
+}
