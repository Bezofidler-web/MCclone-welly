+s32 java_loading_scale(v2s32 size)
+{
+	// Java's automatic GUI scale preserves a 320×240 logical viewport.
+	const s32 max_scale = std::max<s32>(1, std::min(size.X / 320, size.Y / 240));
+	const float preferred_scale = g_settings->getFloat("gui_scaling", 0.5f, 20.0f);
+	return rangelim((s32)std::lround(max_scale * preferred_scale), 1, max_scale);
+}
+
+s32 java_loading_font_size(s32 scale)
+{
+	const float density = RenderingEngine::getDisplayDensity() *
+			g_settings->getFloat("gui_scaling");
+	return std::max<s32>(1, std::lround(10 * scale / density));
+}
