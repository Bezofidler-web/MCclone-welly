+bool Game::waitForJavaTerrain()
+{
+	FpsControl fps_control;
+	fps_control.reset();
+	auto &environment = client->getEnv();
+	LocalPlayer *player = environment.getLocalPlayer();
+	float elapsed = 0.0f;
+	input->clear();
+
+	// Show the arrival screen until the client has its own avatar and the
+	// server has sent the MapBlock at the player's feet. The timeout covers
+	// servers that put the player outside the available map.
+	while (m_rendering_engine->run()) {
+		float dtime;
+		fps_control.limit(device, &dtime);
+		step(dtime);
+		processQueues();
+		if (!checkConnection() || *kill || input->cancelPressed() ||
+				g_gamecallback->shutdown_requested)
+			return false;
+
+		const v3s16 center = floatToInt(player->getPosition(), BS);
+		const bool positioned = player->getCAO() != nullptr;
+		auto *block = positioned ?
+				environment.getClientMap().getBlockNoCreateNoEx(getNodeBlockPos(center)) : nullptr;
+		if (elapsed >= 30.0f || (block && block->isGenerated()))
+			return true;
+
+		m_rendering_engine->draw_load_screen(wstrgettext("Loading terrain..."),
+				guienv, texture_src, dtime, -1, nullptr, {},
+				LoadingScreenStyle::Terrain, positioned && server ? client : nullptr);
+		elapsed += dtime;
+	}
+	return false;
+}
 
