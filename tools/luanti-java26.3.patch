+namespace {
+// Run the five-pixel box filter three times in each direction, as the
+// Java menu does. The HUD is already drawn and the modal is still sharp.
+class JavaPauseBlur final : public TrivialRenderStep
+{
+public:
+	JavaPauseBlur(u32 horizontal, u32 vertical) :
+		m_original(&m_buffer, 0), m_filtered(&m_buffer, 1),
+		m_horizontal(horizontal, {0}), m_vertical(vertical, {1})
+	{
+		m_buffer.setTexture(0, v2f(1.0f), "mcl_pause_scene", video::ECF_A8R8G8B8);
+		m_buffer.setTexture(1, v2f(1.0f), "mcl_pause_filtered", video::ECF_A8R8G8B8);
+		m_horizontal.setRenderSource(&m_buffer);
+		m_horizontal.setRenderTarget(&m_filtered);
+		m_horizontal.setBilinearFilter(0, true);
+		m_vertical.setRenderSource(&m_buffer);
+		m_vertical.setBilinearFilter(0, true);
+	}
+
+	void run(PipelineContext &context) override
+	{
+		m_buffer.reset(context);
+		if (!m_buffer.getTexture(0) || !m_buffer.getTexture(1))
+			return;
+		m_original.reset(context);
+		m_filtered.reset(context);
+		m_screen.reset(context);
+
+		auto *driver = context.device->getVideoDriver();
+		auto *scene = m_original.getIrrRenderTarget(context);
+		if (!scene)
+			return;
+		// With a null source OpenGL3 reads the default framebuffer's colour.
+		driver->blitRenderTarget(nullptr, scene);
+
+		for (int pass = 0; pass < 3; ++pass) {
+			m_horizontal.run(context);
+			RenderTarget *destination = pass == 2 ?
+				static_cast<RenderTarget *>(&m_screen) : &m_original;
+			m_vertical.setRenderTarget(destination);
+			m_vertical.run(context);
+		}
+	}
+
+private:
+	TextureBuffer m_buffer;
+	TextureBufferOutput m_original;
+	TextureBufferOutput m_filtered;
+	ScreenTarget m_screen;
+	PostProcessingStep m_horizontal;
+	PostProcessingStep m_vertical;
+};
+} // namespace
