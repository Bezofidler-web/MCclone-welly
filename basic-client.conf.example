# Basic Luanti renderer. The launcher sets the path to its colour shader.
enable_fog = true
directional_colored_fog = true
fog_start = 0.89
viewing_range = 176
enable_3d_clouds = false
cloud_radius = 10
smooth_lighting = true
display_gamma = 1.22
leaves_style = fancy
enable_waving_leaves = true
enable_waving_plants = true
translucent_liquids = true
enable_waving_water = true
water_wave_height = 0.08
enable_water_reflections = false
enable_dynamic_shadows = true
shadow_map_texture_size = 1024
shadow_map_max_distance = 48
shadow_filters = 1
shadow_soft_radius = 1.2
enable_post_processing = true
tone_mapping = false
enable_bloom = true
enable_volumetric_lighting = false
enable_auto_exposure = false
mip_map = true
bilinear_filter = false
trilinear_filter = false
enable_dig_particles = true
node_highlighting = box
selectionbox_width = 1
fov = 70
view_bobbing_amount = 0.65
pitch_move = true

keymap_inventory = SYSTEM_SCANCODE_8|GAMEPAD_BUTTON_3
keymap_aux1 = SYSTEM_SCANCODE_224|GAMEPAD_BUTTON_2
keymap_camera_mode = SYSTEM_SCANCODE_62
keymap_toggle_debug = SYSTEM_SCANCODE_60
keymap_toggle_fog = SYSTEM_SCANCODE_64
