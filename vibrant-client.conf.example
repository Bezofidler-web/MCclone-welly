# Vibrant profile for Luanti 5.18. Dynamic sun shadows, bloom and water shimmer.
enable_fog = true
directional_colored_fog = true
fog_start = 0.89
viewing_range = 176
enable_3d_clouds = true
soft_clouds = false
cloud_radius = 16
smooth_lighting = true
display_gamma = 1.22
leaves_style = fancy
enable_waving_leaves = true
enable_waving_plants = true
enable_translucent_foliage = true
translucent_liquids = true
enable_waving_water = true
water_wave_height = 0.10
water_wave_length = 14.0
water_wave_speed = 1.2
enable_water_reflections = true
enable_dynamic_shadows = true
shadow_map_texture_size = 2048
shadow_map_max_distance = 80
shadow_filters = 1
shadow_soft_radius = 1.2
shadow_strength_gamma = 1.0
enable_post_processing = true
tone_mapping = false
enable_bloom = true
enable_volumetric_lighting = true
enable_auto_exposure = false
mip_map = true
anisotropic_filter = true
bilinear_filter = false
trilinear_filter = false
enable_dig_particles = true
node_highlighting = box
selectionbox_width = 1
fov = 70
view_bobbing_amount = 0.65
pitch_move = true

# Keyboard defaults for E inventory, Left Ctrl sprint, F5 perspective, F3 debug.
keymap_inventory = SYSTEM_SCANCODE_8|GAMEPAD_BUTTON_3
keymap_aux1 = SYSTEM_SCANCODE_224|GAMEPAD_BUTTON_2
keymap_camera_mode = SYSTEM_SCANCODE_62
keymap_toggle_debug = SYSTEM_SCANCODE_60
keymap_toggle_fog = SYSTEM_SCANCODE_64
