# Optional Luanti 5.18 graphics profile for Mineclonia.
enable_fog = true
directional_colored_fog = true
fog_start = 0.50
viewing_range = 144
enable_3d_clouds = true
soft_clouds = true
cloud_radius = 20
smooth_lighting = true
leaves_style = fancy
enable_waving_leaves = true
enable_waving_plants = true
enable_translucent_foliage = true
translucent_liquids = true
enable_waving_water = true
water_wave_height = 0.28
water_wave_length = 16.0
water_wave_speed = 2.1
enable_water_reflections = true
enable_dynamic_shadows = true
shadow_map_texture_size = 2048
shadow_map_max_distance = 110
shadow_filters = 1
shadow_soft_radius = 2.0
shadow_strength_gamma = 1.0
enable_post_processing = true
tone_mapping = true
enable_bloom = true
enable_volumetric_lighting = true
enable_auto_exposure = false
mip_map = true
anisotropic_filter = true
bilinear_filter = false
trilinear_filter = false
